opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_sexp_digest"
bug-reports: "https://github.com/public-release-reloaded/ppx_sexp_digest/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_sexp_digest.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_sexp_digest/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "bin_prot" {>= "v0.18~" & < "v0.19~"}
  "expect_test_helpers_base" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_conv" {>= "v0.18~" & < "v0.19~"}
  "sexp_grammar" {>= "v0.18~" & < "v0.19~"}
  "stdio" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {>= "0.38.0"}
]
available: arch != "x86_32"
synopsis: "A ppx extension for hashing the sexp_grammar of a type."
description: "
This is meant to be used similarly to `[%bin_digest: t]`. Common sexp serialization
    changes like adding record field annotations don't affect the `[%bin_digest: t]`
    output but do affect this ppx output.
"
